{
  "name": "otp-qr",
  "version": "1.1.0",
  "private": true,
  "description": "Make otpauth:// QR codes for authenticator apps and check the codes they produce, all in the browser.",
  "keywords": [
    "otp",
    "totp",
    "hotp",
    "2fa",
    "mfa",
    "two-factor-authentication",
    "qr-code",
    "qrcode-generator",
    "otpauth",
    "authenticator",
    "google-authenticator",
    "freeotp",
    "otp-verification"
  ],
  "type": "module",
  "license": "MIT",
  "repository": "github:RagedPanda/otp-qr",
  "scripts": {
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-include='scripts/**' --test-coverage-exclude='src/app.js' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100",
    "start": "npx --yes serve@14.2.4 ."
  },
  "engines": {
    "node": ">=20"
  }
}
